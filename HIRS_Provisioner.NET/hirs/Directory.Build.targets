<Project>
  <PropertyGroup>
    <SetupProductName Condition="'$(SetupProductName)' == ''">$(AssemblyName)</SetupProductName>
    <SetupProductManufacturer Condition="'$(SetupProductManufacturer)' == ''">HIRS</SetupProductManufacturer>
    <SetupFeatureId Condition="'$(SetupFeatureId)' == ''">$(AssemblyName)Feature</SetupFeatureId>
    <SetupFeatureName Condition="'$(SetupFeatureName)' == ''">$(AssemblyName)</SetupFeatureName>
    <SetupInstallFolderName Condition="'$(SetupInstallFolderName)' == ''">$(AssemblyName)</SetupInstallFolderName>
    <SetupProductLanguage Condition="'$(SetupProductLanguage)' == ''">1033</SetupProductLanguage>
    <ProductSourceFilePath>$(MSBuildThisFileDirectory)Resources\Product.wxs</ProductSourceFilePath>
    <SetupFilePath Condition="'$(SetupFilePath)' == ''">$(TargetDir)$(AssemblyName).$(PackageVersion).msi</SetupFilePath>
    <WixInstallPath>$(NuGetPackageRoot)wix\3.14.1\tools\</WixInstallPath>
    <Heat>$(WixInstallPath)heat.exe</Heat>
    <Candle>$(WixInstallPath)candle.exe</Candle>
    <Light>$(WixInstallPath)light.exe</Light>
    <WixIntermediateDirectory>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)wix\</WixIntermediateDirectory>
    <HarvestSourceFilePath>$(WixIntermediateDirectory)Harvested.wxs</HarvestSourceFilePath>
    <HarvestObjectFilePath>$(WixIntermediateDirectory)Harvested.wixobj</HarvestObjectFilePath>
    <ProductObjectFilePath>$(WixIntermediateDirectory)Product.wixobj</ProductObjectFilePath>
    <_WindowsFipsEnabled>false</_WindowsFipsEnabled>
    <_WindowsFipsEnabled Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' And '$([MSBuild]::GetRegistryValue(`HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\Lsa\FipsAlgorithmPolicy`,`Enabled`,`0`))' == '1'">true</_WindowsFipsEnabled>
    <EnableFipsCompliantWix Condition="'$(EnableFipsCompliantWix)' == ''">$(_WindowsFipsEnabled)</EnableFipsCompliantWix>
    <WixFipsArg Condition="'$(EnableFipsCompliantWix)' == 'true'">-fips</WixFipsArg>
  </PropertyGroup>

  <Target Name="Msi" DependsOnTargets="Publish">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SetupFilePath)'));$(WixIntermediateDirectory)" />

    <Delete Files="$(PublishDir)tpm_aca_provision.exe" />
    <Move
      Condition="Exists('$(PublishDir)$(AssemblyName).exe')"
      SourceFiles="$(PublishDir)$(AssemblyName).exe"
      DestinationFiles="$(PublishDir)tpm_aca_provision.exe" />

    <PropertyGroup>
      <WixArguments>-nologo -dPublishDir=&quot;$(PublishDir)\&quot; -dSetupProductName=&quot;$(SetupProductName)&quot; -dSetupProductManufacturer=&quot;$(SetupProductManufacturer)&quot; -dSetupFeatureId=&quot;$(SetupFeatureId)&quot; -dSetupFeatureName=&quot;$(SetupFeatureName)&quot; -dSetupInstallFolderName=&quot;$(SetupInstallFolderName)&quot; -dSetupProductVersion=&quot;$(Version)&quot; -dSetupProductLanguage=&quot;$(SetupProductLanguage)&quot;</WixArguments>
    </PropertyGroup>

    <Message Text="Creating msi package $(SetupFilePath)" Importance="high" />
    <Exec Command="&quot;$(Heat)&quot; dir &quot;$(PublishDir)\&quot; -nologo -scom -sreg -sfrag -srd -gg -dr INSTALLFOLDER -cg SourceComponentGroup -var var.PublishDir $(WixFipsArg) -o &quot;$(HarvestSourceFilePath)&quot;" />
    <Exec Command="&quot;$(Candle)&quot; $(WixArguments) $(WixFipsArg) &quot;$(HarvestSourceFilePath)&quot; -o &quot;$(HarvestObjectFilePath)&quot;" />
    <Exec Command="&quot;$(Candle)&quot; $(WixArguments) $(WixFipsArg) &quot;$(ProductSourceFilePath)&quot; -o &quot;$(ProductObjectFilePath)&quot;" />
    <Exec Command="&quot;$(Light)&quot; $(WixArguments) &quot;$(HarvestObjectFilePath)&quot; &quot;$(ProductObjectFilePath)&quot; -o &quot;$(SetupFilePath)&quot;" />
  </Target>

  <Target Name="CopyPaccorPluginAssemblies" AfterTargets="Publish">
    <ItemGroup>
      <PaccorPluginAssembly Include="$(OutputPath)paccor_scripts.dll" Condition="Exists('$(OutputPath)paccor_scripts.dll')" />
      <PaccorPluginAssembly Include="$(OutputPath)Pcie.dll" Condition="Exists('$(OutputPath)Pcie.dll')" />
      <PaccorPluginAssembly Include="$(OutputPath)Smbios.dll" Condition="Exists('$(OutputPath)Smbios.dll')" />
      <PaccorPluginAssembly Include="$(OutputPath)Storage.dll" Condition="Exists('$(OutputPath)Storage.dll')" />
      <PublishPdbFile Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins" Condition="'@(PaccorPluginAssembly)' != ''" />
    <Copy SourceFiles="@(PaccorPluginAssembly)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
    <Delete Files="@(PublishPdbFile)" />
  </Target>
</Project>
