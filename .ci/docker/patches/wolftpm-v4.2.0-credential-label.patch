wolfTPM v4.2.0 credential activation interoperability fix.

MakeCredential/ActivateCredential must use the RSA OAEP label "IDENTITY\0".
Appending the object Name breaks credentials produced by the ACA and tpm2-tools;
a wolfTPM-only round trip hides the mismatch because both commands append it.
The Name remains authenticated through the existing KDF and HMAC operations.
Remove this patch once the pinned upstream release has equivalent handling.

Reference: https://github.com/tpm2-software/tpm2-tools/blob/master/tools/tpm2_makecredential.c
See the following:
https://trustedcomputinggroup.org/wp-content/uploads/Trusted-Platform-Module-2.0-Library-Part-1-Architecture_Version-185_pub.pdf

--- a/src/fwtpm/fwtpm_command.c
+++ b/src/fwtpm/fwtpm_command.c
@@ -15680,19 +15680,12 @@
     }
 #endif
 
-    /* Build OAEP label: "IDENTITY\0" + objectName */
+    /* RSA OAEP uses only "IDENTITY\0". The object Name is bound below
+     * by credential key derivation and the integrity HMAC. */
     if (rc == 0) {
         XMEMCPY(oaepLabel, "IDENTITY", 8);
         oaepLabelSz = 8;
         oaepLabel[oaepLabelSz++] = 0x00;
-        if (objectName.size + oaepLabelSz > (int)sizeof(oaepLabel)) {
-            rc = TPM_RC_SIZE;
-        }
-        else {
-            XMEMCPY(oaepLabel + oaepLabelSz, objectName.name,
-                objectName.size);
-            oaepLabelSz += objectName.size;
-        }
     }
 
     /* Generate seed and encrypt to key's public key */
@@ -15902,19 +15895,12 @@
         }
     }
 
-    /* Build OAEP label: "IDENTITY\0" + activateObj->name */
-    if (rc == 0) {
-        objName = &activateObj->name;
+    /* RSA OAEP uses only "IDENTITY\0". The object Name is bound below
+     * by credential key derivation and the integrity HMAC. */
+    if (rc == 0) {
         XMEMCPY(oaepLabel, "IDENTITY", 8);
         oaepLabelSz = 8;
         oaepLabel[oaepLabelSz++] = 0x00;
-        if (objName->size + oaepLabelSz > (int)sizeof(oaepLabel)) {
-            rc = TPM_RC_SIZE;
-        }
-        else {
-            XMEMCPY(oaepLabel + oaepLabelSz, objName->name, objName->size);
-            oaepLabelSz += objName->size;
-        }
     }
 
     /* Decrypt seed using keyHandle's private key */
